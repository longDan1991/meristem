# 复制成 .env 放在**起进程的目录**（通常就是仓库根）—— .env 只从当前目录加载，不往上找。
# `.env` 不进版本控制；这份示例进，是键名与格式的唯一一份说明。
#
# 路径一律**绝对路径**：相对路径的含义挂在"进程从哪儿起的"上，换个目录启动就悄悄指向另一处，
# 代码不替它推算（也不展开 `~`）。

# ── 模型（必填）──
export MERISTEM_BASE_URL='https://…'       # OpenAI 兼容端点；不要这行就用 provider 自带的端点
export MERISTEM_API_KEY='…'                # 钥匙值本身；只在取它那一处读，不打印、不进配置对象
export MERISTEM_MODEL='provider/model'     # 目录里那份：只管"怎么发"（wire api / 上下文 / 思考通道）
# export MERISTEM_MODEL_ID='…'               # 可选：端点认的 id 与目录里那份不同时（自建网关 / 换了名字）

# ── 数据根（必填）──
export MERISTEM_WORKSPACE='/abs/path'      # agent 的做事目录；账缺省落 <它>/.tree/ledger.jsonl

# ── 可选 ──
# export MERISTEM_TRACE='/abs/path/ledger.jsonl'   # 账换一个位置（同一份账别两个人同时开）
# export MERISTEM_ROLES='/abs/path/roles'          # 额外的角色目录：一个 xml 一个角色
# export MERISTEM_SKILLS='/abs/a:/abs/b'           # 技能根，`:` 分隔，同名 first-wins
